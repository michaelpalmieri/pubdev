        <mxCell id="keys" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#4A7CC7;fillColor=#F5F9FF;fontSize=14;strokeWidth=1.5;" value="KEY NOTES  • All edge hosts are managed centrally by vCenter at the Data Center. • VCF Operations 9 provides licensing and health monitoring for managed hosts. • Edge sites require network connectivity to the Data Center for management and licensing. • During host upgrade, VMs on that host will be unavailable." vertex="1">
          <mxGeometry height="185" width="280" x="20" y="930" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#A7A7A7;fillColor=#FFFFFF;fontSize=12;strokeWidth=1;" value="LEGEND  →  Manages / Controls ⇢  Internet Connection →  Site WAN Connection - -  Infrastructure / External" vertex="1">
          <mxGeometry height="185" width="190" x="320" y="930" as="geometry" />
        </mxCell>
        <mxCell id="req" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#E4A13A;fillColor=#FFF9EF;fontSize=12;strokeWidth=1.2;" value="REQUIREMENTS SUMMARY  ✓ Broadcom subscription for VVF/VCF 9 ✓ VCF Operations 9 deployed at Data Center ✓ vCenter Server 9 at Data Center ✓ Reliable WAN/VPN from all edge sites ✓ DNS, NTP, AD/LDAP reachable from Data Center ✓ Time sync and proper name resolution ✓ Backup solution for all edge sites" vertex="1">
          <mxGeometry height="185" width="410" x="530" y="930" as="geometry" />
        </mxCell>
        <mxCell id="rb" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#D96A6A;fillColor=#FFF7F7;fontSize=12;strokeWidth=1.2;" value="ROLLBACK CONSIDERATIONS  ↶ If upgrade fails before reboot: cancel and remain on ESXi 8.  If upgrade fails after reboot and host will not boot: • Use ESXi 8 installer to reinstall if bootable and restore configuration. • Restore VMs from backups if required." vertex="1">
          <mxGeometry height="185" width="310" x="960" y="930" as="geometry" />
